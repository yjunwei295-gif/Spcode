{
  "version": 2,
  "id": "crystal-neko-pixel-remesh",
  "label": "水晶猫娘",
  "说明": "像素级复刻可编辑规则：改这里再跑 remesh/bake 即可复现或调参。v2 增加高清格与五官表情区。",
  "source": "painted-head-source.png",
  "output": {
    "remeshHead": "remesh-head.png",
    "lawsJson": "generated/desktop-pet-check/crystal-laws.json",
    "lawsMd": "generated/desktop-pet-check/crystal-laws.md",
    "comparePng": "generated/desktop-pet-check/crystal-pixel-compare.png"
  },
  "chroma": {
    "method": "edge-flood",
    "edgeStep": 8,
    "insetSamples": [
      [
        8,
        8
      ],
      [
        20,
        20
      ]
    ],
    "floodThresh": 78,
    "expandThresh": 95,
    "expandPasses": 2,
    "依据": "floodThresh=78 覆盖灰紫底边缘色差；expandThresh=95 清抗锯齿毛边；均远低于发色距(~199)与肤色距，避免吞头发/脸"
  },
  "remesh": {
    "method": "fillRect-1x1",
    "opaqueAlphaMin": 16,
    "说明": "去底后每个不透明像素用 fillRect(x,y,1,1) 按原色重画，保证像素级可复现"
  },
  "bake": {
    "cellSize": 384,
    "headMaxRatio": 0.92,
    "说明": "高清格 384（协议上限 512）；头占满格 92%，避免再糊成 192"
  },
  "face": {
    "说明": "由 analyze-crystal-face.cjs 实测写入；bake 读 landmarks 与 paintMouth/paintBlink",
    "paintMouth": false,
    "paintBlink": true,
    "size": {
      "w": 768,
      "h": 768
    },
    "face": {
      "L": 85,
      "T": 42,
      "R": 689,
      "B": 698,
      "w": 605,
      "h": 657,
      "n": 40610
    },
